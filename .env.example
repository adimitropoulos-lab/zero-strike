ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cl6mb8i9h0003e201j6li0diw/subgraphs/positions-subgraph/0.0.7/gn

NEWS_RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.apnews.com/rss/apf-topnews

BANKROLL_USDC=10000
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.05
MIN_EDGE_BPS=200

# Daily Anthropic spend cap (USD). Agent runs are blocked once exceeded.
DAILY_SPEND_CAP_USD=25.0

# Optional model price overrides ($/M tokens). Defaults match Anthropic
# published prices at time of writing; override if they change.
# PRICING_CLAUDE_OPUS_4_7_INPUT_PER_MTOK=15.00
# PRICING_CLAUDE_OPUS_4_7_OUTPUT_PER_MTOK=75.00

# Embeddings — Voyage AI (Anthropic-recommended) or OpenAI fallback.
# Without either, _search_markets degrades to keyword-overlap matching.
# VOYAGE_API_KEY=pa-...
# OPENAI_API_KEY=sk-...

# Bluesky breaking-news search queries (comma-separated).
# BLUESKY_QUERIES=breaking,developing,just in

# Twitter/X search (paid API). Stays silent if unset.
# TWITTER_BEARER_TOKEN=...
# TWITTER_QUERY=(breaking OR developing) -is:retweet lang:en

# Live execution circuit breakers — required if you flip the --live flag.
MAX_ORDER_USD=500
DAILY_LOSS_CAP_USD=200
MAX_DAILY_VOLUME_USD=5000

# Polymarket signing — only needed for live execution.
# POLY_PRIVATE_KEY=0x...               # EOA signer key
# POLY_FUNDER=0x...                    # proxy wallet that holds USDC
# POLY_SIGNATURE_TYPE=1                # 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE, 0=EOA
